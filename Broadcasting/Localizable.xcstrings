{
  "sourceLanguage" : "en",
  "strings" : {
    " AWS Privacy Policy." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " AWSプライバシーポリシー"
          }
        }
      }
    },
    " Create an Amazon IVS Channel." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Amazon IVSチャンネルを作成する。"
          }
        }
      }
    },
    "*Actual data usage may be higher or lower, depending on network conditions during the livestream." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*実際のデータ使用量は、ライブ配信中のネットワーク状況により増減することがあります。"
          }
        }
      }
    },
    "Actual data usage may be higher or lower, depending on network conditions during the livestream." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際のデータ使用量は、ライブ配信中のネットワーク状況により増減することがあります。"
          }
        }
      }
    },
    "Amazon IVS Broadcast Demo" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amazon IVS 配信デモ"
          }
        }
      }
    },
    "Auto" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動"
          }
        }
      }
    },
    "Auto - " : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動 - "
          }
        }
      }
    },
    "Auto-adjust bitrate" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビットレートを自動調整"
          }
        }
      }
    },
    "Auto-configuration" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動設定"
          }
        }
      }
    },
    "Auto-configuration chooses the best video settings for your current internet connection. You can always run this test again from the app settings." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動設定は、現在のインターネット接続に最適な映像設定を選択します。このテストはアプリの設定からいつでも再実行できます。"
          }
        }
      }
    },
    "Auto-orientation starts a stream in portrait or landscape mode depending on your device orientation." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動向き設定では、デバイスの向きに応じて縦向きまたは横向きで配信を開始します。"
          }
        }
      }
    },
    "Auto-orientation starts a stream in portrait or landscape mode depending on your device orientation. This setting cannot be changed during a stream." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動向き設定では、デバイスの向きに応じて縦向きまたは横向きで配信を開始します。この設定は配信中に変更できません。"
          }
        }
      }
    },
    "Automatically adjust the bitrate during a video stream. Turn on manually set bitrate limits to set the min and max bitrate." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配信中にビットレートを自動調整します。最小・最大ビットレートを指定するには「ビットレート制限を手動設定」をオンにしてください。"
          }
        }
      }
    },
    "Automatically configure resolution, framerate, and bitrate based on current network conditions." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のネットワーク状況に基づいて、解像度・フレームレート・ビットレートを自動設定します。"
          }
        }
      }
    },
    "Back" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戻る"
          }
        }
      }
    },
    "Bitrate" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビットレート"
          }
        }
      }
    },
    "Bitrate, resolution, and framerate impact the quality of your video stream. Note that higher resolutions and framerates will require higher bitrates to avoid compression artifacts. The app will automatically adjust your bitrate based on network conditions." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビットレート・解像度・フレームレートは映像の品質に影響します。高い解像度やフレームレートでは、圧縮ノイズを避けるためにより高いビットレートが必要になります。ビットレートはネットワーク状況に応じて自動調整されます。"
          }
        }
      }
    },
    "Camera Access" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセス"
